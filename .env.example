# Copiez ce fichier en .env.local puis remplissez les valeurs.
# - URL : bouton "Connect" du projet Supabase (ou Project Settings > Data API)
# - Clé : Project Settings > API Keys > "Publishable key" (sb_publishable_...)
#   Ne jamais utiliser la "Secret key" ici : elle contourne les règles RLS.
# Le préfixe VITE_ est obligatoire pour que Vite expose la variable au front.
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
